{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcloud/site-view-link",
	"version": "0.1.0",
	"title": "WP Cloud Site View Link",
	"category": "wpcloud",
	"icon": "button",
	"description": "WP Cloud Site View Link",
	"supports": {
		"html": false
	},
	"textdomain": "wpcloud",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"attributes": {
		"view": {
			"type": "string",
			"default": ""
		},
		"adminOnly": {
			"type": "boolean",
			"default": false
		}
	}
}
