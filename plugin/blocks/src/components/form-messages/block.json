{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcloud/form-messages",
	"version": "0.1.0",
	"title": "Form Messages Container",
	"category": "wpcloud",
	"icon": "menu",
	"description": "WP Cloud Form Message Container",
	"example": {},
	"textdomain": "wpcloud",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"allowedBlocks": [
		"wpcloud/form-message"
	],
	"attributes": {
		"previewAction": {
			"type": "string",
			"default": ""
		},
		"previewType": {
			"type": "string",
			"default": ""
		},
		"previewSchema": {
			"type": "object",
			"default": {}
		}
	},
	"providesContext": {
		"wpcloud-form-message/previewAction": "previewAction",
		"wpcloud-form-message/previewType": "previewType",
		"wpcloud-form-message/previewSchema": "previewSchema"
	}
}
