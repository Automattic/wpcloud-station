{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcloud/card",
	"version": "0.1.0",
	"title": "Card",
	"category": "wpcloud",
	"icon": "index-card",
	"description": "Card block",
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"units": [ "px", "em", "rem", "%"]
		}
	},
	"attributes": {
		"style" : {
			"type": "object"
		}
	},
	"textdomain": "wpcloud",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"editorStyle": "file:./index.css"
}
