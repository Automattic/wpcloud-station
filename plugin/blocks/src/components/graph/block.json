{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcloud/graph",
	"version": "0.1.0",
	"title": "graph",
	"category": "wpcloud",
	"icon": "chart-line",
	"description": "Graph block for WPCloud plot blocks",
	"example": {},
	"supports": {
		"html": false,
		"dimensions": {
			"minHeight": true,
			"minWidth": true
		},
		"spacing": {
			"margin": true,
			"padding": false,
			"blockGap": true
		},
		"color": {
			"textColor": true,
			"backgroundColor": true
		}
	},
	"textdomain": "graph",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"ancestor": ["wpcloud/metrics"],
	"attributes" : {
		"metric" : {
			"type" : "string",
			"default" : "requests"
		},
		"dimension" : {
			"type" : "string",
			"default" : "https_status"
		},
		"resolution" : {
			"type" : "string",
			"default" : 10,
			"enum": [
				"10",
				"20",
				"30",
				"60",
				"120",
				"180",
				"240",
				"300",
				"600",
				"900",
				"1200",
				"1800",
				"3600",
				"7200",
				"10800",
				"14400",
				"21600",
				"28800",
				"43200",
				"86400"
			]
		},
		"summarize": {
			"type": "boolean",
			"default": false
		},
		"topX": {
			"type": "string",
			"default": "20"
		},
		"type": {
			"type": "string",
			"default": "line"
		},
		"orientation": {
			"type": "string",
			"default": "vertical"
		},
		"title" : {
			"type" : "string",
			"default" : "Status Codes"
		},
		"showLegend" : {
			"type" : "boolean",
			"default" : true
		},
		"minWidth" : {
			"type" : "string",
			"default" : "500px"
		},
		"predefinedFilters" : {
			"type" : "array",
			"default" : []
		},
		"allowFrontendFilters" : {
			"type" : "boolean",
			"default" : true,
			"description": "Controls whether filters are shown and if users can add, remove, or modify them on the frontend"
		}
	}
}
