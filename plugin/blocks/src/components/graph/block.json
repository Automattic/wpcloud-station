{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcloud/graph",
	"version": "0.1.0",
	"title": "graph",
	"category": "wpcloud",
	"icon": "chart-line",
	"description": "Graph block for WPCloud plot blocks",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "graph",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"ancestor": ["wpcloud/metrics"],
	"attributes" : {
		"metric" : {
			"type" : "string",
			"default" : "status_codes"
		},
		"type": {
			"type": "string",
			"default": "line"
		},
		"title" : {
			"type" : "string",
			"default" : "Status Codes"
		},
		"showLegend" : {
			"type" : "boolean",
			"default" : true
		}
	}
}